{
  "name": "reservas-restaurante",
  "version": "1.0.0",
  "description": "Reservas de mesa online con panel de sala para un restaurante (demo: Casa Anaga).",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test",
    "build:demo": "node scripts/build-demo.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "^8.9.0"
  },
  "license": "MIT"
}
